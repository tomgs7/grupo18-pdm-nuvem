rules_version = '2';

// Security Rules do Cloud Firestore – Grupo 17
// As regras correm no servidor: mesmo que alguém altere a app, não consegue contorná-las.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // users/{uid} = { email } – usado para partilhar notas por email
    match /users/{uid} {
      allow read: if signedIn();
      // só o próprio escreve, só o campo email, e tem de ser o email da sua conta
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email.lower();
    }

    // notes/{noteId}
    match /notes/{noteId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      // ler: só membros (as queries têm de filtrar por members, porque as regras não são filtros)
      allow read: if isMember();

      // criar: o criador é o dono e o único membro inicial
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // alterar:
      //  - o dono pode mudar tudo menos o próprio ownerId (inclui gerir membros)
      //  - os outros membros só podem mudar o conteúdo
      allow update: if (isOwner() && request.resource.data.ownerId == resource.data.ownerId)
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'text', 'updatedBy', 'updatedAt', 'version', 'imagePath']));

      allow delete: if isOwner();

      // modo sem Cloud Storage: notes/{noteId}/files/foto guarda a miniatura
      match /files/{fileId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/notes/$(noteId)).data.members;
      }
    }
  }
}
